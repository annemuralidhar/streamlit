{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=VulnerableAppDb;Integrated Security=true;"
  },
  "Vulnerabilities": {
    "EnableDetailedErrors": true,
    "ExposeStackTraces": true,
    "AllowDebugEndpoints": true
  }
}
